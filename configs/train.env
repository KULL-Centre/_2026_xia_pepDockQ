# =============================================================================
# pepDockQ training config
# -----------------------------------------------------------------------------
# Consumed by scripts/run_training.sh via `source`. Each line uses
# `: "${VAR:=default}"` so that any variable already set in the environment
# (e.g. `EPOCHS=20 bash scripts/run_training.sh`) wins over the default below.
# -----------------------------------------------------------------------------
# To use a different config file:  CONFIG=my_exp.env bash scripts/run_training.sh
# =============================================================================

# --- Paths (required) --------------------------------------------------------
: "${DATA_PATH:=/path/to/features/graph}"   # directory of pre-computed graph .pt features (features.graph output)
: "${TRAIN_LIST:=data/train.txt}"            # one PDB id per line
: "${VALID_LIST:=data/valid.tsv}"            # validation split TSV (see docs/data_format.md)
: "${TEST_LIST:=data/test.tsv}"              # test split TSV

# --- Training hyperparameters (defaults match pepdockq.train) ---------------
: "${OUTPUT_DIR:=outputs}"
: "${EPOCHS:=6}"
: "${BATCH_SIZE:=32}"
: "${NUM_WORKERS:=8}"
: "${LR:=5e-5}"
: "${DEVICE:=cuda}"

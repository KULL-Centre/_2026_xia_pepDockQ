# =============================================================================
# pepDockQ end-to-end training pipeline config
# -----------------------------------------------------------------------------
# Consumed by scripts/run_training.sh via `source`. Each line uses
# `: "${VAR:=default}"` so that any variable already set in the environment
# (e.g. `EPOCHS=20 bash scripts/run_training.sh`) wins over the default below.
# -----------------------------------------------------------------------------
# To use a different config file:  CONFIG=my_exp.env bash scripts/run_training.sh
# =============================================================================

# --- Inputs ------------------------------------------------------------------
: "${PDB_DIR:=train_data/pdb}"                       # input folder containing per-complex subdirectories
: "${TRAIN_LIST:=train_data/split/train.txt}"        # one training PDB id per line
: "${VALID_LIST:=train_data/split/valid.tsv}"        # validation split TSV
: "${TEST_LIST:=train_data/split/test.tsv}"          # test split TSV

# --- Outputs & Intermediate Working Dir --------------------------------------
: "${WORK_DIR:=train_data/work}"                     # intermediate features live in its subfolders
: "${OUTPUT_DIR:=outputs}"                           # root dir for experiment checkpoints & logs

# --- Assets ------------------------------------------------------------------
: "${ZSCALE_PATH:=assets/amino_acid_zscale.csv}"

# --- Compute & Hyperparameters -----------------------------------------------
: "${NCPUS:=8}"                                      # workers for step 4 (graph feature build)
: "${EPOCHS:=6}"
: "${BATCH_SIZE:=32}"
: "${NUM_WORKERS:=8}"
: "${LR:=5e-5}"
: "${DEVICE:=cuda}"

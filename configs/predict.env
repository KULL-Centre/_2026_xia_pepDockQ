# =============================================================================
# pepDockQ end-to-end inference pipeline config
# -----------------------------------------------------------------------------
# Consumed by scripts/run_prediction.sh via `source`. Each line uses
# `: "${VAR:=default}"` so that any variable already set in the environment
# (e.g. `NCPUS=16 bash scripts/run_prediction.sh`) wins over the default below.
# -----------------------------------------------------------------------------
# Defaults below point at the frozen example under examples/ and the released
# checkpoint under assets/, so `bash scripts/run_prediction.sh` runs the demo
# out of the box (once scripts/download_weights.sh has been run).
# =============================================================================

# --- Inputs ------------------------------------------------------------------
: "${PDB_DIR:=examples/pdb}"                       # input folder of PDB files

# --- Outputs -----------------------------------------------------------------
: "${WORK_DIR:=examples/work}"                     # intermediate feature dirs live here
: "${OUTPUT:=examples/prediction_results.csv}"     # final prediction CSV

# --- Model & assets ----------------------------------------------------------
: "${CHECKPOINT:=assets/model.pth}"                # fetched by scripts/download_weights.sh
: "${ZSCALE_PATH:=assets/amino_acid_zscale.csv}"

# --- Compute -----------------------------------------------------------------
: "${NCPUS:=8}"                                    # workers for stage 3 (graph feature build)
